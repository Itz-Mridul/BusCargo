generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  role          String    // SENDER, STAFF, ADMIN, DRIVER
  name          String
  email         String    @unique
  phone         String?   // optional phone number
  passwordHash  String
  loginCount    Int       @default(0)
  lastLoginAt   DateTime?
  currentLat    Float?    // For DRIVER live location
  currentLng    Float?
  createdAt     DateTime  @default(now())
  parcels       Parcel[]  @relation("SenderParcels")
  driverParcels Parcel[]  @relation("DriverParcels")
}

model City {
  id         String   @id @default(uuid())
  name       String
  state      String   @default("Maharashtra")
  type       String   @default("City") // Metro, City, Town
  depots     Depot[]
  routesSrc  Route[]  @relation("SourceCity")
  routesDst  Route[]  @relation("DestCity")
}

model Depot {
  id           String      @id @default(uuid())
  name         String
  cityId       String
  city         City        @relation(fields: [cityId], references: [id])
  lat          Float
  lng          Float
  routeStops   RouteStop[]
  originParcels Parcel[]   @relation("OriginDepot")
  destParcels  Parcel[]    @relation("DestDepot")
}

model Route {
  id            String      @id @default(uuid())
  name          String
  type          String      // INTERCITY, INTRACITY, LOCAL
  sourceCityId  String
  sourceCity    City        @relation("SourceCity", fields: [sourceCityId], references: [id])
  destCityId    String
  destCity      City        @relation("DestCity", fields: [destCityId], references: [id])
  waypointsJson String      // [{ lat, lng, name }]
  stops         RouteStop[]
  buses         Bus[]
}

model RouteStop {
  id        String  @id @default(uuid())
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id])
  depotId   String
  depot     Depot   @relation(fields: [depotId], references: [id])
  stopOrder Int
}

model Bus {
  id          String   @id @default(uuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id])
  currentLat  Float
  currentLng  Float
  status      String   // IDLE, IN_TRANSIT
  lastUpdated DateTime @default(now())
  parcels     Parcel[]
}

model Parcel {
  id              String        @id @default(uuid())
  trackingId      String        @unique
  senderId        String
  sender          User          @relation("SenderParcels", fields: [senderId], references: [id])
  originDepotId   String
  originDepot     Depot         @relation("OriginDepot", fields: [originDepotId], references: [id])
  destDepotId     String
  destDepot       Depot         @relation("DestDepot", fields: [destDepotId], references: [id])
  busId           String?
  bus             Bus?          @relation(fields: [busId], references: [id])
  driverId        String?
  driver          User?         @relation("DriverParcels", fields: [driverId], references: [id])
  receiverName    String        @default("")
  receiverPhone   String        @default("")
  weight          Float         @default(1)
  serviceType     String        @default("INTERCITY") // INTERCITY, LOCAL, PEER_TO_PEER
  price           Float
  status          String        // BOOKED, IN_TRANSIT, ARRIVED, DELIVERED
  qrCode          String        @default("")
  otpHash         String        @default("")
  createdAt       DateTime      @default(now())
  events          ScanEvent[]
  transactions    Transaction[]
}

model ScanEvent {
  id        String   @id @default(uuid())
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id])
  staffId   String
  eventType String   // LOADED, UNLOADED, DELIVERED
  timestamp DateTime @default(now())
}

model Transaction {
  id               String   @id @default(uuid())
  parcelId         String
  parcel           Parcel   @relation(fields: [parcelId], references: [id])
  amount           Float
  splitTransitPct  Float    // 60%
  splitPlatformPct Float    // 30%
  splitAgentPct    Float    // 10%
  settledAt        DateTime @default(now())
}
